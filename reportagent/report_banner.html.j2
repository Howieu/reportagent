<header class="masthead">
  <div class="scene"><img src="{{ scene_image }}" alt=""><span class="scene-tag">{{ mast_week }}</span></div>
  <div class="mast-body">
    <p class="eyebrow">{{ mast_eyebrow }}</p>
    <h1>{{ mast_title }}</h1>
    <p class="meta-line">{{ mast_meta }}</p>
    <div class="kpis">{% for k in mast_kpis %}<div class="kpi"><span class="kpi-label">{{ k.label }}</span><span class="kpi-value">{{ k.value }}</span>{% if k.note %}<span class="kpi-note">{{ k.note }}</span>{% endif %}</div>{% endfor %}</div>
  </div>
</header>
