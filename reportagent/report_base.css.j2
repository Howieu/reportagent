:root { --paper:#fbf7ef; --card:#ffffff; --ink:#1c2430; --muted:#5b6673; --rule:#cfd6df; --hair:#e6e2d8; --brand:#0b57a4; --tint:#eaf1fa;
  --series:#1f5fbf; --series2:#eb6834; --series2-tint:#fbe3d6; --context:#9aa5b1; --up:#0f7a3d; --down:#c62828; --bar-up:#2e9e5b; --bar-down:#d9534f; --bar-flat:#9aa5b1; }
* { box-sizing:border-box; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
html,body { background:var(--paper); }
body { margin:0; color:var(--ink); font:15px/1.75 "Times New Roman","Liberation Serif","KaiTi","STKaiti","Kaiti SC","楷体","AR PL UKai CN",serif; }
main { max-width:860px; margin:0 auto; padding:20px 20px 44px; }
.banner { border-radius:4px; overflow:hidden; line-height:0; margin-bottom:18px; }
.banner svg { width:100%; height:auto; display:block; }
h1,h2,h3 { font-family:Arial,"Liberation Sans","KaiTi","STKaiti","Kaiti SC","楷体","AR PL UKai CN",sans-serif; }
h1 { font-size:24px; line-height:1.35; margin:0 0 4px; font-weight:700; }
.meta-line { color:var(--muted); font-size:13px; margin:0; }
.ai-note { color:var(--muted); font-style:italic; font-size:13px; margin:4px 0 0; }
.head-rule { border:0; border-top:2px solid var(--brand); margin:12px 0 16px; }
h2 { color:var(--brand); font-size:18px; line-height:1.45; margin:28px 0 8px; font-weight:700; break-after:avoid; }
h3 { font-size:15px; margin:18px 0 6px; font-weight:700; padding-bottom:3px; border-bottom:1.5px solid var(--ink); break-after:avoid; }
p { margin:6px 0; }
.lead { margin-top:0; }
.takeaway { font-weight:700; margin:0 0 6px; }
.note { color:var(--muted); font-size:12.5px; }
.muted { color:var(--muted); }
.summary { background:var(--card); border:1px solid var(--hair); border-left:0; border-radius:4px; padding:10px 14px; margin:6px 0 10px; }
.summary p { margin:4px 0; }
.flat { color:inherit; } .up { color:var(--up); font-weight:700; } .down { color:var(--down); font-weight:700; }
.caption { font-size:13.5px; font-weight:700; text-align:center; margin:14px 0 4px; break-after:avoid; }
.source { font-size:12px; color:var(--muted); margin:3px 0 12px; }
.scroll { overflow-x:auto; background:var(--card); border-radius:4px; }
table { border-collapse:collapse; width:100%; font-size:13.5px; break-inside:auto; }
th { text-align:right; padding:5px 8px; font-weight:700; background:var(--tint); color:var(--brand); white-space:nowrap; }
td { text-align:right; padding:4px 8px; font-variant-numeric:lining-nums tabular-nums; white-space:nowrap; border-bottom:.5px solid var(--hair); }
tr { break-inside:avoid; }
th:first-child,td:first-child { text-align:left; }
tr.total td { font-weight:700; background:#f7f9fc; }
td.l1 { padding-left:8px; font-weight:700; } td.l2 { padding-left:20px; } td.l3 { padding-left:34px; color:#333; }
td.wrap { white-space:normal; text-align:left; min-width:120px; }
ul.tree,ul.tree ul { margin:4px 0; padding-left:22px; }
ul.tree li { margin:3px 0; }
ul.tree ul { list-style:circle; } ul.tree ul ul { list-style:square; }
.line-under { text-decoration:underline; text-underline-offset:3px; }
.potential { color:var(--up); }
.sku { display:block; height:64px; max-width:96px; object-fit:contain; margin:6px 0 2px; background:var(--card); border-radius:3px; }
.chart-row { display:flex; flex-wrap:wrap; gap:12px; justify-content:center; margin:12px 0 4px; }
.chart-card { background:var(--card); border:1px solid var(--hair); border-radius:4px; padding:8px 10px; flex:1 1 300px; max-width:420px; break-inside:avoid; }
.chart-card svg,.fchart { width:100%; height:auto; display:block; }
.chart-title { font:700 13px/1.4 Arial,"KaiTi","STKaiti",sans-serif; text-align:center; margin:0 0 2px; }
.sales-tree { margin:10px 0 4px; }
.tree-row { display:flex; gap:8px; justify-content:center; margin-bottom:8px; }
.tcard { background:var(--card); border:1px solid var(--hair); border-radius:4px; padding:5px 6px 3px; flex:0 1 25%; min-width:0; break-inside:avoid; }
.spark { width:100%; height:auto; display:block; }
.card { background:var(--card); border:1px solid var(--hair); border-radius:4px; padding:10px 14px; margin:8px 0; }
.cbar { display:grid; grid-template-columns:96px 1fr 54px; gap:8px; align-items:center; font-size:13px; margin:3px 0; }
.ctrack { position:relative; height:12px; background:linear-gradient(var(--rule),var(--rule)) center/1px 100% no-repeat; }
.ctrack i { position:absolute; top:1px; bottom:1px; background:var(--series); border-radius:2px; }
.ctrack i.neg { background:var(--series2); }
.cval { text-align:right; }
.hbar { display:grid; grid-template-columns:110px 1fr 120px; gap:8px; align-items:center; font-size:13px; margin:3px 0; }
.hbar .track { height:12px; }
.hbar i { display:block; height:100%; background:var(--context); border-radius:2px; min-width:2px; }
.hbar.selected { font-weight:700; } .hbar.selected i { background:var(--series); }
.hbar .val { text-align:right; }
ol.plain,ul.plain { margin:4px 0 8px; padding-left:22px; }
details { margin-top:8px; font-size:12px; color:var(--muted); }
pre { white-space:pre-wrap; word-break:break-all; font-size:11px; font-family:"Times New Roman",monospace; border-left:1px solid var(--rule); padding-left:8px; }
.synthetic { border:1px solid var(--series2); background:var(--series2-tint); border-radius:4px; font-size:12.5px; padding:4px 10px; margin-bottom:14px; text-align:center; }
@media (max-width:560px) { .tree-row { flex-wrap:wrap; } .tcard { flex:1 1 45%; } .hbar { grid-template-columns:80px 1fr 96px; } }
@media print { main { max-width:none; padding:0; } details,.no-print { display:none !important; } a { color:inherit; text-decoration:none; } }
@page { size:A4; margin:14mm 14mm; background:#fbf7ef; }
