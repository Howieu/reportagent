:root {
  --bg:#f5f5f5; --surface:#ffffff; --surface-warm:#fafafa; --button:#1f1f22; --scene-tag:#ffd54a; --scene-tag-shadow:rgba(0,0,0,.55);
  --fg:rgba(0,0,0,.82); --body:rgba(0,0,0,.68); --muted:rgba(0,0,0,.58); --border:rgba(0,0,0,.08); --border-strong:rgba(0,0,0,.2); --context:rgba(0,0,0,.18);
  --up:#02b940; --down:#ff2442; --flat:#a3a3a3; --up-text:#0a7d33; --down-text:#d4102d; --up-tint:#eaf8ef;
  --line:#1d4f91; --line-soft:#9fb3cf; --highlight:#f2f6fc; --data:#3d8af5; --data-alt:#ff7d03; --data-alt-tint:#ffe9d3;
  --radius-sm:8px; --radius-md:12px;
  --font-body:"Times New Roman","Liberation Serif","KaiTi","STKaiti","Kaiti SC","楷体","AR PL UKai CN",serif;
  --font-head:Arial,"Liberation Sans","KaiTi","STKaiti","Kaiti SC","楷体","AR PL UKai CN",sans-serif;
}
* { box-sizing:border-box; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
html,body { background:var(--bg); }
body { margin:0; color:var(--fg); font:15px/1.75 var(--font-body); }
main { max-width:860px; margin:0 auto; padding:16px 16px 40px; }
svg text { font-family:var(--font-head); }

.masthead { background:var(--surface); border-radius:var(--radius-md); overflow:hidden; margin-bottom:12px; }
.scene { position:relative; line-height:0; }
.scene img { display:block; width:100%; height:auto; }
.scene-tag { position:absolute; left:24px; bottom:18px; font:600 36px/1 var(--font-head); color:var(--scene-tag); text-shadow:0 1px 6px var(--scene-tag-shadow); }
.mast-body { padding:18px 24px 0; }
.eyebrow { font:600 13px/1.5 var(--font-head); color:var(--muted); margin:0 0 2px; }
h1 { font:600 28px/1.35 var(--font-head); margin:0; }
.meta-line { color:var(--muted); font-size:13px; line-height:1.6; margin:6px 0 0; }
.kpis { display:flex; margin-top:14px; border-top:1px solid var(--border); }
.kpi { flex:1 1 0; padding:12px 12px 14px 16px; border-left:1px solid var(--border); min-width:0; }
.kpi:first-child { flex-grow:1.7; padding-left:0; border-left:0; }
.kpi-label { display:block; font:13px/1.4 var(--font-head); color:var(--muted); }
.kpi-value { display:block; font:600 24px/1.25 var(--font-head); margin-top:6px; }
.kpi:first-child .kpi-value { font-size:56px; line-height:1.05; letter-spacing:-.02em; }
.kpi-note { display:block; font-size:12.5px; line-height:1.45; color:var(--muted); margin-top:4px; }

.panel { background:var(--surface); border-radius:var(--radius-md); padding:20px 24px 22px; margin-bottom:12px; -webkit-box-decoration-break:clone; box-decoration-break:clone; break-inside:avoid; }
.panel.flow { break-inside:auto; }
.panel > :first-child { margin-top:0; }
.panel > .split:first-child { padding-top:0; border-top:0; }
h2,h3 { font-family:var(--font-head); font-weight:600; break-after:avoid; }
h2 { font-size:20px; line-height:1.4; margin:0 0 10px; }
h3 { font-size:15px; line-height:1.5; margin:22px 0 6px; }
p { margin:6px 0; }
.lead { color:var(--body); margin:0 0 10px; break-after:avoid; }
.takeaway { font-weight:600; margin:0 0 8px; break-after:avoid; }
.note,.source { color:var(--muted); font-size:12.5px; line-height:1.6; }
.source { margin:8px 0 0; }
.muted { color:var(--muted); font-weight:400; }
.summary p { margin:0; padding:7px 0; border-top:1px solid var(--border); }
.summary p:first-child { border-top:0; padding-top:0; }
.summary p:last-child { padding-bottom:0; }
.flat { color:inherit; } .up { color:var(--up-text); font-weight:600; } .down { color:var(--down-text); font-weight:600; }
.caption,.chart-title { font:600 13px/1.5 var(--font-head); margin:18px 0 6px; break-after:avoid; }
.chart-title { margin:0 0 6px; }

.scroll { overflow-x:auto; }
table { border-collapse:collapse; width:100%; font-size:13.5px; line-height:1.5; }
th { text-align:right; padding:6px 8px; font:600 12.5px/1.4 var(--font-head); color:var(--muted); border-bottom:1px solid var(--border-strong); white-space:nowrap; }
td { text-align:right; padding:6px 8px; font-variant-numeric:lining-nums tabular-nums; white-space:nowrap; border-bottom:1px solid var(--border); }
tr { break-inside:avoid; }
th:first-child,td:first-child { text-align:left; padding-left:0; }
tr.total td { font-weight:600; }
td a { color:inherit; }

ul.tree,ul.tree ul { margin:0; padding:0; list-style:none; }
ul.tree > li { padding:8px 0; border-top:1px solid var(--border); }
ul.tree > li:first-child { border-top:0; padding-top:0; }
ul.tree ul { margin:4px 0 0 2px; padding-left:14px; border-left:1px solid var(--border-strong); }
ul.tree ul li { margin:4px 0; }
ul.tree li:not(:has(ul)) { break-inside:avoid; }
.branch { display:block; break-after:avoid; font:600 12.5px/1.6 var(--font-head); color:var(--muted); }
.tag { display:inline-block; font:600 12px/1.5 var(--font-head); color:var(--up-text); background:var(--up-tint); border-radius:var(--radius-sm); padding:0 6px; }
.sku { display:block; height:64px; max-width:96px; object-fit:contain; margin:6px 0 2px; border-radius:var(--radius-sm); }

.split { display:grid; grid-template-columns:5fr 7fr; gap:24px; align-items:start; margin-top:16px; padding-top:16px; border-top:1px solid var(--border); }
.split.even { grid-template-columns:1fr 1fr; }
.split > * { min-width:0; break-inside:avoid; }
.split .wide { grid-column:1 / -1; padding-top:16px; border-top:1px solid var(--border); }
.split svg,.fchart { width:100%; height:auto; display:block; }

.driver-tree { display:block; width:100%; height:auto; min-width:640px; }
.driver-tree text { font-family:var(--font-head); }
.spark { width:100%; height:auto; display:block; margin-top:4px; }

.cbar { display:grid; grid-template-columns:96px 1fr 54px; gap:8px; align-items:center; font-size:13px; line-height:1.5; margin:4px 0; }
.ctrack { position:relative; height:12px; background:linear-gradient(var(--border-strong),var(--border-strong)) center/1px 100% no-repeat; }
.ctrack i { position:absolute; top:1px; bottom:1px; background:var(--data); border-radius:2px; }
.ctrack i.neg { background:var(--data-alt); }
.cval { text-align:right; }
.hbar { display:grid; grid-template-columns:64px 1fr 104px; gap:8px; align-items:center; font-size:13px; line-height:1.5; margin:4px 0; }
.even .hbar,.wide .hbar { grid-template-columns:96px 1fr 124px; }
.hbar .track { height:10px; }
.hbar i { display:block; height:100%; background:var(--context); border-radius:2px; min-width:2px; }
.hbar.selected { font-weight:600; } .hbar.selected i { background:var(--data); }
.hbar .val { text-align:right; }

ol.plain,ul.plain { margin:0; padding-left:20px; }
ul.plain li,ol.plain li { margin:4px 0; }
details { margin-top:10px; font-size:12.5px; color:var(--muted); }
pre { white-space:pre-wrap; word-break:break-all; font-size:11px; font-family:"Times New Roman",monospace; border-left:1px solid var(--border-strong); padding-left:8px; }
.synthetic { background:var(--data-alt-tint); border-radius:var(--radius-sm); font-size:12.5px; padding:4px 12px; margin-bottom:12px; text-align:center; }

.select { display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end; background:var(--surface); border-radius:var(--radius-md); padding:12px 24px; margin-bottom:12px; }
.panel .select { background:none; padding:0; margin:0 0 12px; border-radius:0; }
.select label { font-size:12.5px; display:block; color:var(--muted); }
.select select,.select input:not([type=hidden]) { display:block; margin-top:2px; height:32px; min-width:130px; padding:0 8px; border:1px solid var(--border-strong); border-radius:var(--radius-sm); background:var(--surface); color:var(--fg); font:inherit; font-size:13px; }
.select button { height:32px; padding:0 16px; border:0; border-radius:999px; background:var(--button); color:var(--surface); font:600 13px/1 var(--font-head); cursor:pointer; }
.select button:focus-visible,.select select:focus-visible,.select input:focus-visible { outline:2px solid var(--data); outline-offset:1px; }

@media (max-width:560px) {
  main { padding:12px 12px 32px; }
  .mast-body { padding:14px 16px 0; } .scene-tag { left:16px; bottom:10px; font-size:24px; } .panel { padding:16px; } .select { padding:12px 16px; }
  h1 { font-size:24px; }
  .kpis { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); }
  .kpi { padding-left:12px; border-top:1px solid var(--border); }
  .kpi:first-child { grid-column:1 / -1; border-top:0; }
  .kpi:nth-child(even) { padding-left:0; border-left:0; }
  .split,.split.even { grid-template-columns:1fr; }
  .hbar,.even .hbar,.wide .hbar { grid-template-columns:72px 1fr 104px; }
}
@media print { main { max-width:none; padding:0; } details,.no-print { display:none !important; } a { color:inherit; text-decoration:none; } .scroll { overflow:visible; } .driver-tree { min-width:0; } table { font-size:12.5px; } th,td { white-space:normal; padding-left:5px; padding-right:5px; } }
@page { size:A4; margin:12mm; background:#f5f5f5; }
