<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>漏斗分析 wk{{ f.week }}</title>
<style>
:root { --ink:#3f3f46; --muted:#71717a; --line:#e8e4e6; --band:#fbd9e5; --card:#fde8ef; --card-strong:#f8c8d9; --accent:#c8102e; --up:#1f7a3f; --down:#c02626; --select:#dceafb; }
* { box-sizing:border-box; }
body { margin:0; background:#fff; color:var(--ink); font:14px/1.6 -apple-system,"PingFang SC","Noto Sans SC","Microsoft YaHei",Arial,sans-serif; }
main { max-width:980px; margin:0 auto; padding:24px 16px 40px; }
h1 { font-size:24px; margin:0 0 4px; }
h2 { font-size:16px; margin:24px 0 10px; color:var(--accent); }
.note { color:var(--muted); font-size:12px; }
.banner { background:var(--band); padding:10px 16px; font-size:18px; font-weight:600; margin:12px 0 14px; }
.up { color:var(--up); } .down { color:var(--down); } .flat { color:var(--muted); }
.kpis { display:grid; grid-template-columns:repeat(3,1fr); gap:6px; }
@media (max-width:560px) { .kpis { grid-template-columns:repeat(2,1fr); } }
.kpi { background:var(--card); padding:10px 14px; }
.kpi .t { font-size:13px; color:var(--muted); }
.kpi .v { font-size:26px; line-height:1.3; }
.kpi .d { font-size:13px; }
.select { background:var(--select); padding:12px 14px; margin:16px 0; display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end; }
.select label { font-size:12px; font-weight:600; display:block; }
.select select,.select input { display:block; margin-top:3px; height:34px; min-width:160px; padding:0 8px; border:1px solid #aebbd0; border-radius:4px; background:#fff; font:inherit; }
.select button { height:34px; padding:0 16px; border:0; border-radius:4px; background:#172f57; color:#fff; font:inherit; cursor:pointer; }
.crumbs { font-size:13px; margin:0 0 8px; }
.crumbs a { color:#1d4f91; }
.funnel { margin:6px 0 4px; }
.fstep { display:grid; grid-template-columns:90px 1fr 170px; gap:10px; align-items:center; margin:6px 0; font-size:13px; }
.ftrack { height:24px; background:#f4f4f5; border-radius:4px; overflow:hidden; }
.ftrack i { display:block; height:100%; background:var(--accent); border-radius:4px; min-width:3px; }
.fconv { color:var(--muted); font-size:12px; padding-left:100px; }
.scroll { overflow-x:auto; }
table { border-collapse:collapse; width:100%; font-size:13px; white-space:nowrap; }
th { background:var(--card-strong); text-align:right; padding:6px 8px; font-weight:600; }
td { text-align:right; padding:5px 8px; border-bottom:1px solid var(--line); font-variant-numeric:tabular-nums; }
th:first-child,td:first-child { text-align:left; }
tr.total td { font-weight:600; background:var(--card); }
td a { color:#1d4f91; }
.insight { background:#faf7f8; border-left:4px solid var(--accent); padding:8px 14px; margin:8px 0; }
.insight p { margin:3px 0; }
details { margin-top:8px; font-size:12px; color:var(--muted); }
pre { white-space:pre-wrap; word-break:break-all; background:#faf7f8; padding:8px; font-size:11px; }
@media print { .select { display:none; } details { display:none; } }
@page { size:A4; margin:12mm 10mm; }
</style>
</head>
<body>
<main>
<h1>漏斗分析 · wk{{ f.week }}</h1>
<div class="note">{{ f.period.start }} 至 {{ f.period.end }}。{{ f.note }}</div>
<div class="banner">数据更新至：{{ f.latest_date }}</div>

{% set t = f.total %}{% set S = t.steps %}
<section class="kpis">
  {% for s in S %}<div class="kpi"><div class="t">{{ s.name }} UV</div><div class="v">{{ s.uv | num }}</div><div class="d">周环比 {{ s.wow | delta }}</div></div>{% endfor %}
  {% for s in S[1:] %}<div class="kpi"><div class="t">{{ S[loop.index0].name }} → {{ s.name }}</div><div class="v">{{ '%.2f%%' | format(s.conv or 0) }}</div><div class="d">较上周 {{ pts(s.conv_change) }}</div></div>{% endfor %}
  <div class="kpi"><div class="t">{{ S[0].name }} → {{ S[-1].name }}（整体）</div><div class="v">{{ '%.2f%%' | format(t.overall or 0) }}</div><div class="d">较上周 {{ pts((t.overall - t.overall_prev) if t.overall is not none and t.overall_prev is not none else none) }}</div></div>
</section>

<form class="select" method="get" action="{{ base }}">
  <label>周次<input name="week" value="{{ f.week }}" pattern="\d{6}" required></label>
  <label>Select Dimension<select name="dimension">{% for k, v in f.dimensions.items() %}<option value="{{ k }}"{{ ' selected' if k == f.dimension }}>{{ v }}</option>{% endfor %}</select></label>
  {% for k, v in f.filters.items() %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
  <button>应用</button>
</form>
{% if f.filters %}<p class="crumbs">已下钻到：{% for k, v in f.filters.items() %}{{ f.dimensions[k] }} = {{ v }}{{ '，' if not loop.last }}{% endfor %}。<a href="{{ base }}?week={{ f.week }}">返回全部</a></p>{% endif %}

<h2>整体漏斗</h2>
<div class="funnel">
  {% set top = S[0].uv or 1 %}
  {% for s in S %}
    {% if s.conv is not none %}<div class="fconv">↓ 转化 {{ '%.2f%%' | format(s.conv) }}（前 4 周 {{ '%.2f%%' | format(s.conv_r4 or 0) }}）</div>{% endif %}
    <div class="fstep"><span>{{ s.name }}</span><span class="ftrack"><i style="width:{{ '%.2f' | format(s.uv / top * 100) }}%"></i></span><span>{{ s.uv | num }} UV，占首步 {{ '%.2f%%' | format(s.uv / top * 100) }}</span></div>
  {% endfor %}
</div>

<div class="insight">
  <p>流失最大的是到 <b>{{ f.biggest_drop.name }}</b> 这一步，转化 {{ '%.2f%%' | format(f.biggest_drop.conv) }}。</p>
  {% if f.opportunity %}<p>流量较大但转化低于整体的{{ f.dimension_label }}：{% for r in f.opportunity %}<b>{{ r.name }}</b>（UV 占比 {{ '%.1f%%' | format(r.share) }}，整体转化 {{ '%.2f%%' | format(r.overall or 0) }}）{{ '、' if not loop.last }}{% endfor %}。</p>{% endif %}
</div>

<h2>近 8 周整体转化</h2>
{{ f.trend | map(attribute='overall') | list | spark(width=640, height=70) }}
<p class="note">{% for x in f.trend %}{{ x.week[-2:] }}周 {{ '%.2f%%' | format(x.overall or 0) }}{{ '　' if not loop.last }}{% endfor %}</p>

<h2>按{{ f.dimension_label }}拆分{% if f.next_dimension %}（点名称下钻到{{ f.dimensions[f.next_dimension] }}）{% endif %}</h2>
<div class="scroll"><table>
  <tr><th>{{ f.dimension_label }}</th><th>UV 占比</th>{% for s in S %}<th>{{ s.name }}</th>{% endfor %}{% for s in S[1:] %}<th>{{ S[loop.index0].name }}→{{ s.name }}</th>{% endfor %}<th>整体转化</th><th>较上周</th></tr>
  <tr class="total"><td>合计</td><td>100%</td>{% for s in S %}<td>{{ s.uv | num }}</td>{% endfor %}{% for s in S[1:] %}<td>{{ '%.2f%%' | format(s.conv or 0) }}</td>{% endfor %}<td>{{ '%.2f%%' | format(t.overall or 0) }}</td><td>{{ pts((t.overall - t.overall_prev) if t.overall is not none and t.overall_prev is not none else none) }}</td></tr>
  {% for r in f.rows[:40] %}
  <tr><td>{% if f.next_dimension %}<a href="{{ drill(r.name) }}">{{ r.name }}</a>{% else %}{{ r.name }}{% endif %}</td><td>{{ '%.1f%%' | format(r.share or 0) }}</td>
    {% for s in r.steps %}<td>{{ s.uv | num }}</td>{% endfor %}{% for s in r.steps[1:] %}<td>{{ ('%.2f%%' | format(s.conv)) if s.conv is not none else '—' }}</td>{% endfor %}
    <td>{{ ('%.2f%%' | format(r.overall)) if r.overall is not none else '—' }}</td><td>{{ pts((r.overall - r.overall_prev) if r.overall is not none and r.overall_prev is not none else none) }}</td></tr>
  {% endfor %}
</table></div>
{% if f.rows | length > 40 %}<p class="note">共 {{ f.rows | length }} 行，按 UV 显示前 40 行。</p>{% endif %}

<details><summary>查看执行的 {{ f.queries | length }} 条 SQL</summary>{% for q in f.queries %}<p><b>{{ q.purpose }}</b>（{{ q.ms }} ms）</p><pre>{{ q.sql }}</pre>{% endfor %}</details>
</main>
</body>
</html>
