# 数仓连接（SQLAlchemy URL），建议使用只读账号
# DuckDB:     duckdb:///data/demo.duckdb
# Postgres:   postgresql+psycopg://user:pass@host:5432/db
# MySQL:      mysql+pymysql://user:pass@host:3306/db
# MaxCompute: odps://ACCESS_ID:SECRET@PROJECT/?endpoint=ENDPOINT
REPORTAGENT_DB_URL=duckdb:///data/real.duckdb
REPORTAGENT_SEMANTIC=semantic.real.yaml

# Agent 模型（OpenAI 兼容接口）。不配置时报告用规则模板，对话不可用
AGENT_API_KEY=
AGENT_BASE_URL=
# 问题改写、辅助思考、意图识别、回答修正 Agent 共用，必须支持工具调用
AGENT_MODEL=
# 报告撰写 Agent，不需要调用工具，不设置时用 AGENT_MODEL
WRITER_AGENT_MODEL=
# 被限流时切换的模型。付费模型会产生费用
AGENT_FALLBACK_MODEL=
# 传给模型接口的附加参数（JSON），不用于报告撰写 Agent 单独配置的模型
AGENT_EXTRA_BODY=

# 联网搜索服务。不配置时界面不显示开关；用户打开开关才会调用，可能按次计费
WEB_SEARCH_URL=
WEB_SEARCH_ENGINE=
# 不设置时用 AGENT_API_KEY
WEB_SEARCH_API_KEY=
# REPORTAGENT_WEB_PER_HOUR=10
